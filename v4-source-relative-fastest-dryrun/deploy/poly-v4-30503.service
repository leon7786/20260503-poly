[Unit]
Description=Polymarket V4 BTC15m source-relative dry-run dashboard 30503
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/20260503-poly/v4-source-relative-fastest-dryrun
EnvironmentFile=/etc/poly-v4-30503.env
ExecStart=/root/projects/20260503-poly/.venv/bin/python /root/projects/20260503-poly/v4-source-relative-fastest-dryrun/src/poly_v1_trader.py
Restart=always
RestartSec=2
StandardOutput=append:/root/projects/20260503-poly/logs/poly-v4-30503-stdout.log
StandardError=append:/root/projects/20260503-poly/logs/poly-v4-30503-stderr.log
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
